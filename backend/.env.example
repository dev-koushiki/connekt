# ====================================================================
# CONNEKT Platform Environment Configuration (Template)
# ====================================================================

PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=connekt_db

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Domain & OTP Settings
CONNEKT_DOMAIN=connekt.me
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
DEFAULT_COUNTRY_CODE=+91
SHOW_OTP_PREVIEW=false

# Real Phone SMS Gateway Configuration
SMS_PROVIDER=android_gateway
SMS_GATEWAY_URL=http://192.168.1.15:8080/message
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
FAST2SMS_API_KEY=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@connekt.me
SMTP_PASS=your_email_password
SMTP_FROM="CONNEKT Identity <noreply@connekt.me>"

# Client / CORS
CLIENT_URL=http://localhost:5000
